  "cards": [
    {
      "dot": "cyan",
      "title": "One architecture model",
      "items": [
        "Scopes compose hierarchy and replicated topology.",
        "Processor MLIR supplies functional behavior.",
        "Rust or YAML models supply symbolic performance scenarios."
      ]
    },
    {
      "dot": "violet",
      "title": "Explicit Rust outputs",
      "items": [
        "Binary generators invoke cargo build --release and embed the architecture.",
        "MLIR and visualization exporters return strings that the application writes to files."
      ]
    },
    {
      "dot": "emerald",
      "title": "Decoupled visualization",
      "items": [
        "Rust owns the renderer-neutral YAML schema.",
        "Node selects semantic views; Archify renders standalone HTML.",
        "The generated gallery is a static web application with no backend."
      ]
    }
