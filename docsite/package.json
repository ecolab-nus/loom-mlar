{
  "name": "loom-mlar-docsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "diagrams:build": "node scripts/build-archify-diagrams.mjs && node scripts/copy-archify-diagrams.mjs static/diagrams",
    "prestart": "npm run diagrams:build",
    "start": "docusaurus start",
    "prebuild": "npm run diagrams:build",
    "build": "docusaurus build",
    "postbuild": "node scripts/copy-archify-diagrams.mjs build/diagrams",
    "build:lavish": "npm run diagrams:build && docusaurus build --config docusaurus.lavish.config.ts --out-dir ../docs/.lavish/docusaurus && node scripts/copy-archify-diagrams.mjs ../docs/.lavish/docusaurus/diagrams",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
