func @matmul_SS_f16(
  in A: f16[M, K],
  in B: f16[K, N],
  out C: f16[M, N]
) {
  linalg.matmul ins(%A, %B : memref<?x?xf16>, memref<?x?xf16>) outs(%C : memref<?x?xf16>)
}

func @matmul_SR_f16(
  in A: f16[M, K],
  in B: f16[K, N] @space(1),
  out C: f16[M, N]
) {
  linalg.matmul ins(%A, %B : memref<?x?xf16>, memref<?x?xf16, 1>) outs(%C : memref<?x?xf16>)
}

func @matmul_RS_f16(
  in A: f16[M, K] @space(1),
  in B: f16[K, N],
  out C: f16[M, N]
) {
  linalg.matmul ins(%A, %B : memref<?x?xf16, 1>, memref<?x?xf16>) outs(%C : memref<?x?xf16>)
}

func @matmul_RR_f16(
  in A: f16[M, K] @space(1),
  in B: f16[K, N] @space(1),
  out C: f16[M, N]
) {
  linalg.matmul ins(%A, %B : memref<?x?xf16, 1>, memref<?x?xf16, 1>) outs(%C : memref<?x?xf16>)
}

func @batch_matmul_SS_f16(
  in A: f16[B, M, K],
  in Bmat: f16[B, K, N],
  out C: f16[B, M, N]
) {
  linalg.batch_matmul ins(%A, %Bmat : memref<?x?x?xf16>, memref<?x?x?xf16>) outs(%C : memref<?x?x?xf16>)
}

func @batch_matmul_SR_f16(
  in A: f16[B, M, K],
  in Bmat: f16[B, K, N] @space(1),
  out C: f16[B, M, N]
) {
  linalg.batch_matmul ins(%A, %Bmat : memref<?x?x?xf16>, memref<?x?x?xf16, 1>) outs(%C : memref<?x?x?xf16>)
}

func @batch_matmul_RS_f16(
  in A: f16[B, M, K] @space(1),
  in Bmat: f16[B, K, N],
  out C: f16[B, M, N]
) {
  linalg.batch_matmul ins(%A, %Bmat : memref<?x?x?xf16, 1>, memref<?x?x?xf16>) outs(%C : memref<?x?x?xf16>)
}

func @batch_matmul_RR_f16(
  in A: f16[B, M, K] @space(1),
  in Bmat: f16[B, K, N] @space(1),
  out C: f16[B, M, N]
) {
  linalg.batch_matmul ins(%A, %Bmat : memref<?x?x?xf16, 1>, memref<?x?x?xf16, 1>) outs(%C : memref<?x?x?xf16>)
}

func @vec_vsum_f16(
  in a: f16[P, R],
  out out: f16[P]
) {
  linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0)>
      ],
      iterator_types = ["parallel", "reduction"]
    }
    ins(%a : memref<?x?xf16>)
    outs(%out : memref<?xf16>) {
      ^bb0(%x: f16, %acc: f16):
        %s = arith.addf %x, %acc : f16
        linalg.yield %s : f16
    }
}

func @vec_vmax_f16(
  in a: f16[P, R],
  out out: f16[P]
) {
  linalg.generic {
      indexing_maps = [
        affine_map<(d0, d1) -> (d0, d1)>,
        affine_map<(d0, d1) -> (d0)>
      ],
      iterator_types = ["parallel", "reduction"]
    }
    ins(%a : memref<?x?xf16>)
    outs(%out : memref<?xf16>) {
      ^bb0(%x: f16, %acc: f16):
        %m = arith.maximumf %x, %acc : f16
        linalg.yield %m : f16
    }
}

func @vec_max1_f16(
  in a: f16[L],
  in b: f16[L],
  out out: f16[L]
) {
  linalg.generic {
      indexing_maps = [
        affine_map<(d0) -> (d0)>,
        affine_map<(d0) -> (d0)>,
        affine_map<(d0) -> (d0)>
      ],
      iterator_types = ["parallel"]
    }
    ins(%a, %b : memref<?xf16>, memref<?xf16>)
    outs(%out : memref<?xf16>) {
      ^bb0(%x: f16, %y: f16, %z: f16):
        %cmp = arith.cmpf ogt, %x, %y : f16
        %sel = arith.select %cmp, %x, %y : f16
        linalg.yield %sel : f16
    }
}

func @elementwise_add_f16(
  in a: f16[M, N],
  in b: f16[M, N],
  out out: f16[M, N]
) {
  linalg.add ins(%a, %b : memref<?x?xf16>, memref<?x?xf16>) outs(%out : memref<?x?xf16>)
}

func @elementwise_mul_f16(
  in a: f16[M, N],
  in b: f16[M, N],
  out out: f16[M, N]
) {
  linalg.mul ins(%a, %b : memref<?x?xf16>, memref<?x?xf16>) outs(%out : memref<?x?xf16>)
}
