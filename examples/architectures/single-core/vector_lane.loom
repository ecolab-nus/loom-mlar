func @vector_add {
  params: [L]
  ins:
    lhs: !loom.buffer<Lxf16>
    rhs: !loom.buffer<Lxf16>
  outs:
    out: !loom.buffer<Lxf16>
  linalg.generic {
    indexing_maps = [
      affine_map<(d0) -> (d0)>,
      affine_map<(d0) -> (d0)>,
      affine_map<(d0) -> (d0)>
    ],
    iterator_types = ["parallel"]
  }
  ins(%lhs, %rhs : memref<?xf16>, memref<?xf16>)
  outs(%out : memref<?xf16>) {
    ^bb0(%a: f16, %b: f16, %unused: f16):
      %sum = arith.addf %a, %b : f16
      linalg.yield %sum : f16
  }
}
