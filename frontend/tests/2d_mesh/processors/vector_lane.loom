func @vec_select_f16(
  in cond: i1[L],
  in a: f16[L],
  in b: f16[L],
  out out: f16[L]
) {
  linalg.generic {
      indexing_maps = [
        affine_map<(d0) -> (d0)>,
        affine_map<(d0) -> (d0)>,
        affine_map<(d0) -> (d0)>,
        affine_map<(d0) -> (d0)>
      ],
      iterator_types = ["parallel"]
    }
    ins(%cond, %a, %b)
    outs(%out) {
      ^bb0(%c: i1, %x: f16, %y: f16, %z: f16):
        %m = arith.select %c, %x, %y : f16
        linalg.yield %m : f16
    }
}

