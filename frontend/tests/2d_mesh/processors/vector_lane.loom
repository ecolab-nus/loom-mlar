func @vec_max_f16(
  in a: f16[L],
  in b: f16[L],
  out out: f16[L]
) {
  linalg.generic {
        indexing_maps = [
          affine_map<(d0) -> (d0)>,
          affine_map<(d0) -> (d0)>,
          affine_map<(d0) -> (d0)>
        ],
        iterator_types = ["parallel"]
      }
      ins(%a, %b)
      outs(%out) {
      ^bb0(%x: f16, %y: f16, %z: f16):
        %m = arith.maximumf %x, %y : f16
        linalg.yield %m : f16
    }
}

