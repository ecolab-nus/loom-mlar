}

func @vec_sum_f16(
  in a: f16[L],
  out init: f16
) {
  linalg.generic {
        indexing_maps = [
          affine_map<(d0) -> (d0)>,
          affine_map<(d0) -> ()>
        ],
        iterator_types = ["reduction"]
      }
      ins(%a)
      outs(%init) {
      ^bb0(%x: f16, %acc: f16):
        %s = arith.addf %x, %acc : f16
        linalg.yield %s : f16
    }
}

