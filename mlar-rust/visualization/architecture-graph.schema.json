{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom-mlar.local/schema/architecture-graph.schema.json",
  "title": "MLAR Architecture Graph",
  "description": "JSON payload exported from mlar-rust for web visualization with React Flow.",
  "type": "object",
  "required": ["schema_version", "architecture", "nodes", "edges"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mlar.arch-graph.v1"
    },
    "architecture": {
      "type": "object",
      "required": ["name", "labels"],
      "properties": {
        "name": { "type": "string" },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "dimensions"],
            "properties": {
              "name": { "type": "string" },
              "dimensions": { "$ref": "#/$defs/dimensions" }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "label", "dimensions", "details"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["memory", "processor"] },
          "name": { "type": "string" },
          "label": { "type": "string" },
          "dimensions": { "$ref": "#/$defs/dimensions" },
          "details": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "region", "resource"],
                "properties": {
                  "type": { "const": "memory" },
                  "region": { "$ref": "#/$defs/memory_region" },
                  "resource": { "$ref": "#/$defs/resource" }
                }
              },
              {
                "type": "object",
                "required": ["type", "element", "total_instances"],
                "properties": {
                  "type": { "const": "processor" },
                  "element": { "$ref": "#/$defs/processor_elem" },
                  "total_instances": { "type": ["integer", "null"], "minimum": 0 }
                }
              }
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "source",
          "target",
          "source_name",
          "target_name",
          "label",
          "bandwidth",
          "latency",
          "constraints",
          "sharing",
          "map"
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "const": "link" },
          "name": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "source_name": { "type": "string" },
          "target_name": { "type": "string" },
          "label": { "type": "string" },
          "bandwidth": { "$ref": "#/$defs/expr" },
          "latency": { "anyOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }] },
          "constraints": { "type": "string" },
          "sharing": { "type": "string" },
          "map": {
            "type": "object",
            "required": ["source_dimensions", "target_dimensions", "expressions"],
            "properties": {
              "source_dimensions": { "$ref": "#/$defs/dimensions" },
              "target_dimensions": { "$ref": "#/$defs/dimensions" },
              "expressions": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "size_expr", "size_const"],
        "properties": {
          "name": { "type": "string" },
          "size_expr": { "type": "string" },
          "size_const": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "size_expr": {
      "type": "object",
      "required": ["expr", "const_value"],
      "properties": {
        "expr": { "type": "string" },
        "const_value": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "expr": {
      "type": "object",
      "required": ["expr", "const_value"],
      "properties": {
        "expr": { "type": "string" },
        "const_value": { "type": ["integer", "null"] }
      }
    },
    "resource": {
      "type": "object",
      "required": ["name", "quantity"],
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 0 }
      }
    },
    "resource_req": {
      "type": "object",
      "required": ["resource", "quantity"],
      "properties": {
        "resource": { "$ref": "#/$defs/resource" },
        "quantity": { "type": "integer", "minimum": 0 }
      }
    },
    "mlir_module": {
      "type": "object",
      "required": ["path", "functions"],
      "properties": {
        "path": { "type": "string" },
        "functions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "processor_elem": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "name", "compute", "resources"],
          "properties": {
            "kind": { "const": "unit" },
            "name": { "type": ["string", "null"] },
            "compute": { "anyOf": [{ "$ref": "#/$defs/mlir_module" }, { "type": "null" }] },
            "resources": {
              "type": "array",
              "items": { "$ref": "#/$defs/resource_req" }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "dimensions", "elem"],
          "properties": {
            "kind": { "const": "array" },
            "name": { "type": ["string", "null"] },
            "dimensions": { "$ref": "#/$defs/dimensions" },
            "elem": { "$ref": "#/$defs/processor_elem" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "parts"],
          "properties": {
            "kind": { "const": "set" },
            "name": { "type": ["string", "null"] },
            "parts": {
              "type": "array",
              "items": { "$ref": "#/$defs/processor_elem" }
            }
          }
        }
      ]
    },
    "memory_region": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "name", "capacity_bytes", "access_granularity"],
          "properties": {
            "kind": { "const": "bank" },
            "name": { "type": ["string", "null"] },
            "capacity_bytes": { "$ref": "#/$defs/size_expr" },
            "access_granularity": { "anyOf": [{ "$ref": "#/$defs/size_expr" }, { "type": "null" }] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "dimensions", "elem"],
          "properties": {
            "kind": { "const": "replicated" },
            "name": { "type": ["string", "null"] },
            "dimensions": { "$ref": "#/$defs/dimensions" },
            "elem": { "$ref": "#/$defs/memory_region" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name", "parts"],
          "properties": {
            "kind": { "const": "group" },
            "name": { "type": ["string", "null"] },
            "parts": {
              "type": "array",
              "items": { "$ref": "#/$defs/memory_region" }
            }
          }
        }
      ]
    }
  }
}
